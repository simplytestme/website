<?php

/**
 * @file
 * Hook implementations for the simplytest_tugboat module.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 *
 * @return array<string, array<string, mixed>>
 *   The theme hook definitions.
 */
function simplytest_tugboat_theme(): array {
  return [
    'simplytest_launch_statistics' => [
      'variables' => [
        'window_days' => 30,
        'totals' => [],
        'daily' => [],
        'daily_peak' => 1,
        'projects' => [],
        'core_versions' => [],
        'install_profiles' => [],
        'project_types' => [],
        'first_recorded_at' => NULL,
      ],
    ],
  ];
}
