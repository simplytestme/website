<?php

/**
 * @file
 * Install, update and uninstall functions for the standard installation profile.
 */

use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\simplytest_projects\CoreVersionManager;
use Drupal\user\Entity\User;

/**
 * Implements hook_install_tasks().
 */
function simplytest_install_tasks(&$install_state) {
  return [
    'simplytest_install_setup' => [
      'display_name' => new TranslatableMarkup('Install setup'),
    ],
    'simplytest_fetch_drupal_core_versions' => [
      'display_name' => new TranslatableMarkup('Fetch Drupal Core Versions'),
    ],
  ];
}

/**
 * Perform actions to set up the site for this profile.
 */
function simplytest_install_setup() {
  // Assign user 1 the "administrator" role.
  $user = User::load(1);
  $user->addRole('administrator');
  $user->save();
}

/**
 * Ensures Drupal core versions are available on install.
 */
function simplytest_fetch_drupal_core_versions() {
  $core_version_manager = \Drupal::service('simplytest_projects.core_version_manager');
  assert($core_version_manager instanceof CoreVersionManager);
  $core_version_manager->updateData(7);
  $core_version_manager->updateData(8);
  $core_version_manager->updateData(9);
  $core_version_manager->updateData(10);
}

/**
 * Installs the Sentry logger.
 */
function simplytest_update_11001(): void {
  // Config import would install the module on its own, from the entry in
  // core.extension.yml. Installing it here instead means the database matches
  // config/sync by the time anything compares the two, which is what
  // `drush deploy` and the config:status CI job do.
  \Drupal::service('module_installer')->install(['simplytest_sentry']);
}

/**
 * Uninstalls the Update Status module.
 */
function simplytest_update_11002(): void {
  // Config import would uninstall it on its own, from core.extension.yml.
  // Uninstalling it here instead means the database matches config/sync by the
  // time anything compares the two.
  //
  // @see simplytest_update_11001()
  //
  // Without the second argument this takes every module that depends on Update
  // Status with it. simplytest_projects declared that dependency for a URL
  // constant, and uninstalling it drops the project and version tables, so the
  // default turned a config change into data loss. The dependency is gone, and
  // this makes sure nothing that grows one later is uninstalled by surprise.
  \Drupal::service('module_installer')->uninstall(['update'], FALSE);
}
