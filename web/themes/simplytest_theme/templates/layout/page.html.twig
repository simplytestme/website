{#
/**
 * @file
 * Page layout: header, content, footer.
 *
 * The header and footer are intentionally hardcoded — nothing on this site is
 * managed through block or theme configuration.
 */
#}
<div class="flex min-h-screen flex-col bg-white">

  <header role="banner" class="border-b border-st-line">
    <div class="mx-auto flex w-full max-w-[1280px] items-center justify-between px-6 py-5 lg:px-16">
      <a href="{{ front_page }}" class="flex items-center gap-3">
        <img src="{{ base_path ~ directory }}/logo.svg" alt="" class="block h-[34px]">
        <span class="flex items-baseline gap-0.5">
          <span class="text-[19px] font-extrabold tracking-[-0.02em] text-st-body">simplytest</span>
          <span class="font-mono text-[15px] text-st-soft">.me</span>
        </span>
      </a>
      <nav class="flex items-center gap-7 text-sm font-medium">
        <a href="https://www.drupal.org" class="flex items-center gap-2 text-st-slate hover:text-st-accent-dark">
          <img src="{{ base_path ~ directory }}/images/drupal-drop.svg" alt="" class="h-4">
          <span>Drupal.org</span>
        </a>
        <span class="hidden rounded-full border border-st-accent-line bg-st-accent-tint px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-st-accent-dark sm:inline-block">2-hour sandboxes</span>
      </nav>
    </div>
  </header>

  <main role="main" class="flex-1">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
    {% if page.messages %}
      <div class="mx-auto w-full max-w-[1280px] px-6 lg:px-16">
        {{ page.messages }}
      </div>
    {% endif %}
    {% block main_content %}
      <div class="mx-auto w-full max-w-[1280px]">
        {{ page.content }}
      </div>
    {% endblock %}
  </main>

  <footer role="contentinfo" class="border-t border-st-line">
    <div class="mx-auto flex w-full max-w-[1280px] flex-col items-start justify-between gap-10 px-6 pb-11 pt-9 lg:flex-row lg:items-center lg:px-16">
      <div class="flex flex-col gap-3.5">
        <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-st-faint">Free and open source, sponsored by</span>
        <div class="flex flex-wrap items-center gap-8">
          {# Heights differ per logo: wide wordmarks read at 26px, while the
             stacked and padded lockups need more height to look the same
             visual size. #}
          <a href="https://www.centarro.io/?utm_campaign=simplytest&amp;utm_source=sponsors">
            <img src="{{ base_path ~ directory }}/images/sponsors/centarro.svg" alt="Centarro" class="h-5 opacity-80">
          </a>
          <a href="https://www.amazee.io/?utm_campaign=simplytest&amp;utm_source=sponsors">
            <img src="{{ base_path ~ directory }}/images/sponsors/amazeelogo.png" alt="amazee.io" class="h-9 opacity-80">
          </a>
          <a href="https://www.qed42.com/?utm_campaign=simplytest&amp;utm_source=sponsors">
            <img src="{{ base_path ~ directory }}/images/sponsors/qed42.png" alt="QED42" class="h-12 opacity-80">
          </a>
          <a href="https://bluehorn.digital/?utm_campaign=simplytest&amp;utm_source=sponsors">
            <img src="{{ base_path ~ directory }}/images/sponsors/bluehorndigital.png" alt="Blue Horn Digital" class="h-10 opacity-80">
          </a>
        </div>
      </div>
      <nav class="flex gap-6 text-[13px]">
        <a href="{{ path('simplytest_tugboat.statistics') }}" class="text-st-soft hover:text-st-accent-dark">Statistics</a>
        <a href="https://github.com/simplytestme/website" class="text-st-soft hover:text-st-accent-dark">Source</a>
        <a href="https://www.drupal.org/project/issues/simplytest?categories=All" class="text-st-soft hover:text-st-accent-dark">Report a problem</a>
        <a href="https://www.drupal.org/join-slack" class="text-st-soft hover:text-st-accent-dark">Slack</a>
      </nav>
    </div>
  </footer>

</div>
